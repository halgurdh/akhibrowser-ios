#include "Common.xcconfig"
#include "Release.xcconfig"
#include "version.xcconfig"

// Your Apple Team ID goes in AkhiSigning.xcconfig, next to this file: see AkhiSigning.xcconfig.example
AKHI_DEVELOPMENT_TEAM =
#include? "AkhiSigning.xcconfig"
DEVELOPMENT_TEAM = $(AKHI_DEVELOPMENT_TEAM)

MOZ_BUNDLE_DISPLAY_NAME = AkhiBrowser
MOZ_BUNDLE_ID = org.akhibrowser.ios
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon_Akhi
CODE_SIGN_ENTITLEMENTS = Client/Entitlements/FirefoxApplication.entitlements
CHANNEL = release
OTHER_SWIFT_FLAGS = $(OTHER_SWIFT_FLAGS_common) -DMOZ_CHANNEL_$(CHANNEL)
MOZ_INTERNAL_URL_SCHEME = firefox-internal
